#!/usr/bin/env bash

[[ -f ~/.config/user-dirs.dirs ]] && source "$HOME/.config/user-dirs.dirs"
OUTPUT_DIR="${SCREENRECORD_DIR:-${XDG_VIDEOS_DIR:-$HOME/Videos}}"

# 检查文件存储路径
if [[ ! -d "$OUTPUT_DIR" ]]; then
	notify-send "屏幕录制文件保存目录不存在: $OUTPUT_DIR" -u critical -t 3000
	exit 1
fi

# 状态文件路径
RECORDING_FILE="/tmp/$USER-recording"
RECORDING_STATUS_FILE="/tmp/$USER-recording-status"
RECORD_END_FILE="/tmp/$USER-end-record"

# 检查是否正在录制视频
if [ -f "$RECORDING_FILE" ]; then
	# 正在录制视频，现在停止录制
	echo "停止录制中..."
	# 发送停止录制标识
	touch "$RECORD_END_FILE"
	exit 0
else
	# 录制文件时间格式化
	TIMESTAMP=$(date +%Y-%m-%d_%H%M%S)
	# 录制文件路径
	RECORD_FILE="$OUTPUT_DIR/recording-$TIMESTAMP.mp4"
	AUDIO_FILE="$OUTPUT_DIR/recording-$TIMESTAMP-audio.wav"
	VIDEO_FILE="$OUTPUT_DIR/video-$TIMESTAMP.mp4"

	# 尚未开始录制，启动视频录制
	# 检查录制模式
	if [ "$1" == "output" ]; then
		MODE="显示器全屏录制"
	else
		MODE="区域录制"
	fi

	echo "$MODE" >"$RECORDING_FILE"

	# 启动系统音频录制
	if [ "$2" == "audio" ]; then
		ffmpeg -f pulse -i "$(pactl get-default-sink).monitor" -f pulse -i "$(pactl get-default-source)" -filter_complex amix=inputs=2 "$AUDIO_FILE" &
	else
		ffmpeg -f pulse -i "$(pactl get-default-sink).monitor" -c:a pcm_s16le "$AUDIO_FILE" &
	fi
	FFMPGE_PID=$!
	echo "ffmpeg PID $FFMPGE_PID"

	# 启动视频录制
	if [ "$1" == "output" ]; then
		OUTPUT=$(hyprctl monitors -j | jq -r '.[] | select(.focused == true).name')
		wf-recorder -o "$OUTPUT" -f "$RECORD_FILE" "$@" &
	else
		wf-recorder -g "$(slurp)" -f "$RECORD_FILE" "$@" &
	fi
	WF_RECORDER_PID=$!
	echo "wf-recorder PID $WF_RECORDER_PID"
	notify-send "屏幕录制已开始"

	# 启动计时器，记录录制时长
	SECONDS=0
	while kill -0 $WF_RECORDER_PID 2>/dev/null; do
		sleep 1
		SECONDS=$((SECONDS + 1))
		# 更新状态文件以供 waybar 显示
		echo "$SECONDS" >"$RECORDING_STATUS_FILE"

		# 检查是否存在停止标识文件
		if [ -f "$RECORD_END_FILE" ]; then
			echo "停止录制标识已检测到。"
			kill "$WF_RECORDER_PID"
			kill "$FFMPGE_PID"
			rm "$RECORD_END_FILE"
			break
		fi
	done &
	TIMER_PID=$!
	echo "timmer PID $TIMER_PID"

	# 等待录制进程结束
	wait $WF_RECORDER_PID
	kill $FFMPGE_PID 2 >/dev/null
	kill $TIMER_PID 2 >/dev/null

	# 合并视频和音频
	ffmpeg -i "$RECORD_FILE" -i "$AUDIO_FILE" -c:v copy -c:a aac "$VIDEO_FILE" && echo "合并视频和音频成功" || echo "合并视频和音频失败"

	# 清除临时文件
	rm "$RECORD_FILE" "$AUDIO_FILE"
	rm "$RECORDING_FILE" "$RECORDING_STATUS_FILE"

	# 发送录制结束通知
	DURATION=$(printf '%02d:%02d:%02d' $((SECONDS / 3600)) $(((SECONDS % 3600) / 60)) $((SECONDS % 60)))
	notify-send "录制结束" "保存至：$VIDEO_FILE\n时长：$DURATION"

	exit 0
fi
