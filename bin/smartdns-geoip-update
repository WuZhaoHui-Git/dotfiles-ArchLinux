#!/usr/bin/env bash

curl "https://cdn.jsdelivr.net/gh/Loyalsoldier/v2ray-rules-dat@release/direct-list.txt" -o direct-list.conf
curl "https://cdn.jsdelivr.net/gh/Loyalsoldier/v2ray-rules-dat@release/apple-cn.txt" -o apple-cn.conf
curl "https://cdn.jsdelivr.net/gh/Loyalsoldier/v2ray-rules-dat@release/google-cn.txt" -o google-cn.conf

sed "s/^full://g;/^regexp:.*$/d;s/^/nameserver \//g;s/$/\/cn/g" -i direct-list.conf
sed "s/^full://g;/^regexp:.*$/d;s/^/nameserver \//g;s/$/\/cn/g" -i apple-cn.conf
sed "s/^full://g;/^regexp:.*$/d;s/^/nameserver \//g;s/$/\/cn/g" -i google-cn.conf

sudo mv direct-list.conf /etc/smartdns/
sudo mv apple-cn.conf /etc/smartdns/
sudo mv google-cn.conf /etc/smartdns/

sudo systemctl stop smartdns
sudo rm -f /tmp/smartdns.cache /var/cache/smartdns/smartdns.cache
sudo systemctl start smartdns
