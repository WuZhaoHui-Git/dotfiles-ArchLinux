#!/usr/bin/env bash

case "$1" in
shutdown)
	systemctl poweroff
	;;
poweroff)
	systemctl poweroff
	;;
reboot)
	systemctl reboot
	;;
lock)
	hyprlock
	;;
logout)
	hyprctl dispatch 'hl.dsp.exit()' || hyprctl dispatch exit 0
	;;
hibenate)
	systemctl hibernate
	;;
suspend)
	systemctl suspend
	;;
*) ;;
esac
