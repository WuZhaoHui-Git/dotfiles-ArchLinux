#
# banner generate by http://www.network-science.de/ascii/
# use font style standard

include=~/.config/themes/current/mako.conf
default-timeout=5000
max-history=20
width=450
height=150
border-radius=8
padding=10
border-size=2
font=Noto Sans CJK SC 11
outer-margin=20

# 勿扰模式隐藏通知
[mode=do-not-disturb]
invisible=true

# 勿扰模式不隐藏手动发送的通知
[mode=do-not-disturb app-name=notify-send]
invisible=false

# 不隐藏重要通知
[urgency=critical]
default-timeout=0

# blueman 连接需要确认PIN码设备操作
[app-name="blueman" actionable]
on-button-left=invoke-action confirm
on-button-right=invoke-action deny

[app-name="Music Player Daemon" actionable]
on-button-left=invoke-action next
on-button-right=invoke-action play-pause
