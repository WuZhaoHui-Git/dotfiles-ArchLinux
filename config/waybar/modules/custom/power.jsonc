// 请查看文档
// https://github.com/Alexays/Waybar/wiki/Module:-Custom#config
{
  "custom/shutdown": {
    "format": "",
    "on-click": "power shutdown",
    "tooltip-format": " 关机",
  },
  "custom/reboot": {
    "format": "",
    "on-click": "power reboot",
    "tooltip-format": " 重启",
  },
  "custom/lock": {
    "format": "",
    "on-click": "power lock",
    "tooltip-format": " 锁屏",
  },
  "custom/logout": {
    "format": "󰿅",
    "on-click": "power logout",
    "tooltip-format": "󰿅 注销",
  },
  "custom/hibernate": {
    "format": "",
    "on-click": "power hibernate",
    "tooltip-format": " 休眠",
  },
  "custom/suspend": {
    "format": "",
    "on-click": "power suspend",
    "tooltip-format": " 挂起",
  },
}
